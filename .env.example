# Server logging threshold: debug, info, warn, or error.
LOG_LEVEL=info

# Optional Phase 4 live-model evaluation and generation. Deterministic CI does not require these.
OPENAI_API_KEY=
AI_WORKFLOW_SECRET=
OPENAI_GENERATION_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Phase 5 authentication. Configure both together; public browsing works without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Phase 6 live ingestion. Secrets must be at least 32 characters.
INGESTION_SECRET=
CRON_SECRET=
REDIS_REST_URL=
REDIS_REST_TOKEN=
LIVE_SESSION_KEY=

# Direct PostgreSQL connection used by Prisma ORM. Replace for local/Neon development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/f1_watchcoach
