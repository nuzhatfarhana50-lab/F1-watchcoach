generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionType {
  PRACTICE_1
  PRACTICE_2
  PRACTICE_3
  QUALIFYING
  SPRINT_SHOOTOUT
  SPRINT_QUALIFYING
  SPRINT
  RACE
}

enum RaceStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum RaceMomentType {
  RACE_START
  OVERTAKE
  PIT_STOP
  UNDERCUT
  OVERCUT
  STRATEGY_CHANGE
  SAFETY_CAR
  VIRTUAL_SAFETY_CAR
  RED_FLAG
  PENALTY
  CRASH
  CONTACT
  MECHANICAL_FAILURE
  TEAM_ORDER
  RADIO_MESSAGE
  TYRE_DEGRADATION
  LOCK_UP
  RESTART
  TECHNICAL_ISSUE
  DRIVER_MISTAKE
  DRIVER_PERFORMANCE
  CHAMPIONSHIP_EVENT
  QUALIFYING_LAP
}

enum RaceMomentStatus {
  CURATED
  DETECTED
  VERIFIED
  REJECTED
}

enum ParticipantRole {
  PRIMARY
  SECONDARY
  AFFECTED
}

enum SourceProvider {
  F1
  FIA
  OPENF1
  JOLPICA
  FASTF1
  YOUTUBE
  WIKIMEDIA
  TEAM
  DRIVER
  OTHER
}

enum SourceKind {
  OFFICIAL_REPORT
  STRUCTURED_DATA
  VIDEO
  IMAGE
  DOCUMENT
  ARTICLE
}

enum ExternalResourceType {
  SEASON
  CIRCUIT
  GRAND_PRIX
  SESSION
  RACE
  DRIVER
  TEAM
  RACE_MOMENT
  LAP
  POSITION
  PIT_STOP
  TYRE_STINT
  RACE_CONTROL_EVENT
  RESULT
  CHAMPIONSHIP_STANDING
}

enum TyreCompound {
  SOFT
  MEDIUM
  HARD
  INTERMEDIATE
  WET
  UNKNOWN
}

enum RaceControlCategory {
  SAFETY_CAR
  VIRTUAL_SAFETY_CAR
  RED_FLAG
  PENALTY
  FLAG
  WEATHER
  OTHER
}

enum StandingKind {
  DRIVER
  CONSTRUCTOR
}

enum ConceptCategory {
  STRATEGY
  TYRES
  RACING
  ENGINEERING
  REGULATIONS
}

enum MediaProvider {
  OFFICIAL_F1
  YOUTUBE
  WIKIMEDIA
  FIA
  TEAM
  DRIVER
}

enum MediaKind {
  VIDEO
  IMAGE
  DOCUMENT
}

enum MomentConnectionReason {
  SAME_CONCEPT
  SAME_DRIVER
  SAME_CIRCUIT
  SIMILAR_STRATEGY
  HISTORICAL_PARALLEL
  CHAMPIONSHIP_CONTEXT
  TECHNICAL_PARALLEL
  TEAM_HISTORY
}

enum AiGenerationKind {
  EXPLANATION
  CONCEPT_CLASSIFICATION
  CONNECTION_DISCOVERY
}

enum AiGenerationStatus {
  VALIDATED
  FALLBACK
  REJECTED
}

enum EmbeddingTargetType {
  RACE_MOMENT
  CONCEPT
  EXPLANATION
}

enum ExplanationDepth {
  BEGINNER
  STANDARD
  DETAILED
}

enum LearningStyle {
  BALANCED
  VISUAL
  TECHNICAL
}

enum RaceProgressStatus {
  STARTED
  COMPLETED
}

enum LearningState {
  UNSEEN
  ENCOUNTERED
  LEARNING
  UNDERSTOOD
  REINFORCED
}

model Season {
  id                    String                  @id @default(uuid()) @db.Uuid
  year                  Int                     @unique
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  grandsPrix            GrandPrix[]
  teamIdentities        TeamSeasonIdentity[]
  driverMemberships     DriverTeamMembership[]
  externalReferences    ExternalDataReference[]
  championshipStandings ChampionshipStanding[]
}

model Circuit {
  id                 String                  @id @default(uuid()) @db.Uuid
  slug               String                  @unique
  name               String
  locality           String?
  country            String
  countryCode        String                  @db.Char(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  grandsPrix         GrandPrix[]
  externalReferences ExternalDataReference[]
}

model GrandPrix {
  id                    String                  @id @default(uuid()) @db.Uuid
  seasonId              String                  @db.Uuid
  circuitId             String                  @db.Uuid
  round                 Int
  officialName          String
  shortName             String
  startDate             DateTime                @db.Date
  endDate               DateTime                @db.Date
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  season                Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  circuit               Circuit                 @relation(fields: [circuitId], references: [id], onDelete: Restrict)
  sessions              Session[]
  race                  Race?
  championshipStandings ChampionshipStanding[]
  externalReferences    ExternalDataReference[]

  @@unique([seasonId, round])
  @@index([circuitId])
}

model Session {
  id                 String                  @id @default(uuid()) @db.Uuid
  grandPrixId        String                  @db.Uuid
  type               SessionType
  name               String
  startsAt           DateTime                @db.Timestamptz(3)
  endsAt             DateTime?               @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  grandPrix          GrandPrix               @relation(fields: [grandPrixId], references: [id], onDelete: Cascade)
  race               Race?
  moments            RaceMoment[]
  laps               Lap[]
  positions          Position[]
  pitStops           PitStop[]
  tyreStints         TyreStint[]
  raceControlEvents  RaceControlEvent[]
  results            Result[]
  externalReferences ExternalDataReference[]

  @@unique([grandPrixId, type])
}

model Race {
  id                 String                  @id @default(uuid()) @db.Uuid
  grandPrixId        String                  @unique @db.Uuid
  sessionId          String                  @unique @db.Uuid
  status             RaceStatus              @default(SCHEDULED)
  scheduledLaps      Int?
  actualLaps         Int?
  startedAt          DateTime?               @db.Timestamptz(3)
  endedAt            DateTime?               @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  grandPrix          GrandPrix               @relation(fields: [grandPrixId], references: [id], onDelete: Cascade)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moments            RaceMoment[]
  externalReferences ExternalDataReference[]
  userHistories      UserRaceHistory[]
}

model Driver {
  id                    String                  @id @default(uuid()) @db.Uuid
  slug                  String                  @unique
  givenName             String
  familyName            String
  code                  String?
  permanentNumber       Int?
  nationality           String?
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  memberships           DriverTeamMembership[]
  moments               RaceMomentDriver[]
  laps                  Lap[]
  positions             Position[]
  pitStops              PitStop[]
  tyreStints            TyreStint[]
  results               Result[]
  championshipStandings ChampionshipStanding[]
  externalReferences    ExternalDataReference[]
  userPreferences       UserDriverPreference[]
}

model Team {
  id                    String                  @id @default(uuid()) @db.Uuid
  slug                  String                  @unique
  canonicalName         String
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  seasonIdentities      TeamSeasonIdentity[]
  driverMemberships     DriverTeamMembership[]
  moments               RaceMomentTeam[]
  results               Result[]
  championshipStandings ChampionshipStanding[]
  externalReferences    ExternalDataReference[]
  userPreferences       UserTeamPreference[]
}

model TeamSeasonIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  teamId          String    @db.Uuid
  seasonId        String    @db.Uuid
  displayName     String
  constructorName String
  nationality     String?
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season          Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId, validFrom])
  @@index([seasonId])
}

model DriverTeamMembership {
  id        String    @id @default(uuid()) @db.Uuid
  driverId  String    @db.Uuid
  teamId    String    @db.Uuid
  seasonId  String    @db.Uuid
  carNumber Int?
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([driverId, teamId, seasonId, validFrom])
  @@index([teamId, seasonId])
  @@index([seasonId])
}

model RaceMoment {
  id                  String                  @id @default(uuid()) @db.Uuid
  raceId              String                  @db.Uuid
  sessionId           String                  @db.Uuid
  slug                String
  type                RaceMomentType
  status              RaceMomentStatus        @default(CURATED)
  title               String
  summary             String
  lapNumber           Int?
  occurredAt          DateTime?               @db.Timestamptz(3)
  sequence            Int
  importance          Int                     @default(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  race                Race                    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  session             Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  drivers             RaceMomentDriver[]
  teams               RaceMomentTeam[]
  sources             RaceMomentSource[]
  concepts            RaceMomentConcept[]
  explanations        Explanation[]
  media               RaceMomentMedia[]
  outgoingConnections MomentConnection[]      @relation("ConnectionSourceMoment")
  incomingConnections MomentConnection[]      @relation("ConnectionTargetMoment")
  externalReferences  ExternalDataReference[]
  aiGenerations       AiGeneration[]
  embeddings          EmbeddingRecord[]
  userEncounters      UserMomentEncounter[]
  lastViewedBy        UserRaceHistory[]       @relation("LastViewedMoment")

  @@unique([raceId, slug])
  @@unique([raceId, sequence])
  @@index([sessionId, lapNumber])
  @@index([type, status])
}

model RaceMomentDriver {
  raceMomentId String          @db.Uuid
  driverId     String          @db.Uuid
  role         ParticipantRole @default(PRIMARY)
  raceMoment   RaceMoment      @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  driver       Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([raceMomentId, driverId])
  @@index([driverId])
}

model RaceMomentTeam {
  raceMomentId String          @db.Uuid
  teamId       String          @db.Uuid
  role         ParticipantRole @default(PRIMARY)
  raceMoment   RaceMoment      @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  team         Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([raceMomentId, teamId])
  @@index([teamId])
}

model Source {
  id                    String                   @id @default(uuid()) @db.Uuid
  provider              SourceProvider
  kind                  SourceKind
  title                 String
  url                   String                   @unique
  publishedAt           DateTime?                @db.Timestamptz(3)
  retrievedAt           DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  moments               RaceMomentSource[]
  laps                  Lap[]
  positions             Position[]
  pitStops              PitStop[]
  tyreStints            TyreStint[]
  raceControlEvents     RaceControlEvent[]
  results               Result[]
  championshipStandings ChampionshipStanding[]
  concepts              ConceptSource[]
  explanations          ExplanationSource[]
  media                 MediaSource[]
  momentConnections     MomentConnectionSource[]
  externalReferences    ExternalDataReference[]
  aiGenerations         AiGenerationSource[]
}

model RaceMomentSource {
  raceMomentId String     @db.Uuid
  sourceId     String     @db.Uuid
  raceMoment   RaceMoment @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  source       Source     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([raceMomentId, sourceId])
  @@index([sourceId])
}

model Concept {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique
  name         String
  category     ConceptCategory
  definition   String
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  moments      RaceMomentConcept[]
  explanations ExplanationConcept[]
  sources      ConceptSource[]
  embeddings   EmbeddingRecord[]
  userStates   UserLearningState[]

  @@index([category, name])
}

model RaceMomentConcept {
  raceMomentId String     @db.Uuid
  conceptId    String     @db.Uuid
  raceMoment   RaceMoment @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  concept      Concept    @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@id([raceMomentId, conceptId])
  @@index([conceptId])
}

model ConceptSource {
  conceptId String  @db.Uuid
  sourceId  String  @db.Uuid
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([conceptId, sourceId])
  @@index([sourceId])
}

model Explanation {
  id            String               @id @default(uuid()) @db.Uuid
  raceMomentId  String               @db.Uuid
  slug          String
  whatHappened  String
  whyItHappened String
  whyItMatters  String
  watchNext     String
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  raceMoment    RaceMoment           @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  concepts      ExplanationConcept[]
  sources       ExplanationSource[]
  embeddings    EmbeddingRecord[]

  @@unique([raceMomentId, slug])
}

model AiGeneration {
  id               String             @id @default(uuid()) @db.Uuid
  raceMomentId     String             @db.Uuid
  kind             AiGenerationKind
  status           AiGenerationStatus
  idempotencyKey   String             @unique
  providerResponseId String?
  model            String
  promptVersion    String
  contextReference String
  output           Json
  validationStatus String
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  raceMoment       RaceMoment         @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  sources          AiGenerationSource[]

  @@index([raceMomentId, kind, createdAt])
  @@index([model, promptVersion])
}

model AiGenerationSource {
  aiGenerationId String       @db.Uuid
  sourceId       String       @db.Uuid
  aiGeneration   AiGeneration @relation(fields: [aiGenerationId], references: [id], onDelete: Cascade)
  source         Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([aiGenerationId, sourceId])
  @@index([sourceId])
}

model EmbeddingRecord {
  id            String              @id @default(uuid()) @db.Uuid
  targetType    EmbeddingTargetType
  raceMomentId  String?             @db.Uuid
  conceptId     String?             @db.Uuid
  explanationId String?             @db.Uuid
  model         String
  dimensions    Int
  contentHash   String
  embedding     Unsupported("vector(1536)")
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  raceMoment    RaceMoment?         @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  concept       Concept?            @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  explanation   Explanation?        @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@index([raceMomentId])
  @@index([conceptId])
  @@index([explanationId])
  @@index([targetType, model])
}

model User {
  id                 String                 @id @default(uuid()) @db.Uuid
  externalAuthId     String                 @unique
  explanationDepth   ExplanationDepth       @default(BEGINNER)
  learningStyle      LearningStyle          @default(BALANCED)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  raceHistory        UserRaceHistory[]
  momentEncounters   UserMomentEncounter[]
  learningStates     UserLearningState[]
  interests          UserInterest[]
  driverPreferences  UserDriverPreference[]
  teamPreferences    UserTeamPreference[]
}

model UserRaceHistory {
  userId           String             @db.Uuid
  raceId           String             @db.Uuid
  status           RaceProgressStatus @default(STARTED)
  progressPercent  Int                @default(0)
  lastMomentId     String?            @db.Uuid
  lastViewedAt     DateTime           @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  race             Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  lastMoment       RaceMoment?         @relation("LastViewedMoment", fields: [lastMomentId], references: [id], onDelete: SetNull)

  @@id([userId, raceId])
  @@index([userId, lastViewedAt])
  @@index([raceId])
  @@index([lastMomentId])
}

model UserMomentEncounter {
  userId         String     @db.Uuid
  raceMomentId   String     @db.Uuid
  encounterCount Int        @default(1)
  firstSeenAt    DateTime   @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime   @default(now()) @db.Timestamptz(3)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceMoment     RaceMoment @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)

  @@id([userId, raceMomentId])
  @@index([raceMomentId])
}

model UserLearningState {
  userId         String        @db.Uuid
  conceptId      String        @db.Uuid
  state          LearningState @default(UNSEEN)
  encounterCount Int           @default(0)
  lastUpdatedAt  DateTime      @default(now()) @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept        Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([userId, conceptId])
  @@index([conceptId, state])
}

model UserInterest {
  userId    String   @db.Uuid
  topic     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
}

model UserDriverPreference {
  userId   String @db.Uuid
  driverId String @db.Uuid
  weight   Int    @default(1)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([userId, driverId])
  @@index([driverId])
}

model UserTeamPreference {
  userId String @db.Uuid
  teamId String @db.Uuid
  weight Int    @default(1)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

model ExplanationConcept {
  explanationId String      @db.Uuid
  conceptId     String      @db.Uuid
  explanation   Explanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  concept       Concept     @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@id([explanationId, conceptId])
  @@index([conceptId])
}

model ExplanationSource {
  explanationId String      @db.Uuid
  sourceId      String      @db.Uuid
  explanation   Explanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  source        Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([explanationId, sourceId])
  @@index([sourceId])
}

model Media {
  id                    String            @id @default(uuid()) @db.Uuid
  provider              MediaProvider
  providerId            String?
  kind                  MediaKind
  title                 String
  url                   String            @unique
  embedUrl              String?
  startTimestampSeconds Int?
  license               String?
  attribution           String
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  moments               RaceMomentMedia[]
  sources               MediaSource[]

  @@unique([provider, providerId])
  @@index([kind])
}

model RaceMomentMedia {
  raceMomentId String     @db.Uuid
  mediaId      String     @db.Uuid
  raceMoment   RaceMoment @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([raceMomentId, mediaId])
  @@index([mediaId])
}

model MediaSource {
  mediaId  String @db.Uuid
  sourceId String @db.Uuid
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([mediaId, sourceId])
  @@index([sourceId])
}

model MomentConnection {
  id             String                   @id @default(uuid()) @db.Uuid
  sourceMomentId String                   @db.Uuid
  targetMomentId String                   @db.Uuid
  reason         MomentConnectionReason
  explanation    String
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  sourceMoment   RaceMoment               @relation("ConnectionSourceMoment", fields: [sourceMomentId], references: [id], onDelete: Cascade)
  targetMoment   RaceMoment               @relation("ConnectionTargetMoment", fields: [targetMomentId], references: [id], onDelete: Cascade)
  sources        MomentConnectionSource[]

  @@unique([sourceMomentId, targetMomentId, reason])
  @@index([targetMomentId, reason])
}

model MomentConnectionSource {
  momentConnectionId String           @db.Uuid
  sourceId           String           @db.Uuid
  momentConnection   MomentConnection @relation(fields: [momentConnectionId], references: [id], onDelete: Cascade)
  source             Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([momentConnectionId, sourceId])
  @@index([sourceId])
}

model Lap {
  id                 String                  @id @default(uuid()) @db.Uuid
  sessionId          String                  @db.Uuid
  driverId           String                  @db.Uuid
  sourceId           String                  @db.Uuid
  number             Int
  startedAt          DateTime?               @db.Timestamptz(3)
  durationMs         Int?
  isPersonalBest     Boolean                 @default(false)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([sessionId, driverId, number])
  @@index([driverId, number])
  @@index([sourceId])
}

model Position {
  id                 String                  @id @default(uuid()) @db.Uuid
  sessionId          String                  @db.Uuid
  driverId           String                  @db.Uuid
  sourceId           String                  @db.Uuid
  sequence           Int
  recordedAt         DateTime?               @db.Timestamptz(3)
  lapNumber          Int?
  position           Int
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([sessionId, driverId, sequence])
  @@index([sessionId, recordedAt])
  @@index([driverId, lapNumber])
  @@index([sourceId])
}

model PitStop {
  id                   String                  @id @default(uuid()) @db.Uuid
  sessionId            String                  @db.Uuid
  driverId             String                  @db.Uuid
  sourceId             String                  @db.Uuid
  stopNumber           Int
  lapNumber            Int
  occurredAt           DateTime?               @db.Timestamptz(3)
  stationaryDurationMs Int?
  pitLaneDurationMs    Int?
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  session              Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver               Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  source               Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences   ExternalDataReference[]

  @@unique([sessionId, driverId, stopNumber])
  @@index([sessionId, lapNumber])
  @@index([sourceId])
}

model TyreStint {
  id                 String                  @id @default(uuid()) @db.Uuid
  sessionId          String                  @db.Uuid
  driverId           String                  @db.Uuid
  sourceId           String                  @db.Uuid
  stintNumber        Int
  startLap           Int
  endLap             Int?
  compound           TyreCompound
  tyreAgeAtStart     Int                     @default(0)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([sessionId, driverId, stintNumber])
  @@index([sessionId, startLap])
  @@index([sourceId])
}

model RaceControlEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  sessionId          String                  @db.Uuid
  sourceId           String                  @db.Uuid
  sequence           Int
  occurredAt         DateTime?               @db.Timestamptz(3)
  lapNumber          Int?
  category           RaceControlCategory
  message            String
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([sessionId, sequence])
  @@index([sessionId, lapNumber])
  @@index([sourceId])
}

model Result {
  id                 String                  @id @default(uuid()) @db.Uuid
  sessionId          String                  @db.Uuid
  driverId           String                  @db.Uuid
  teamId             String                  @db.Uuid
  sourceId           String                  @db.Uuid
  classification     Int?
  gridPosition       Int?
  lapsCompleted      Int
  points             Decimal                 @default(0) @db.Decimal(8, 2)
  status             String
  fastestLapRank     Int?
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  session            Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driver             Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  team               Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([sessionId, driverId])
  @@unique([sessionId, classification])
  @@index([teamId, sessionId])
  @@index([sourceId])
}

model ChampionshipStanding {
  id                 String                  @id @default(uuid()) @db.Uuid
  seasonId           String                  @db.Uuid
  afterGrandPrixId   String                  @db.Uuid
  driverId           String?                 @db.Uuid
  teamId             String?                 @db.Uuid
  sourceId           String                  @db.Uuid
  kind               StandingKind
  position           Int
  points             Decimal                 @default(0) @db.Decimal(8, 2)
  wins               Int                     @default(0)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  season             Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  afterGrandPrix     GrandPrix               @relation(fields: [afterGrandPrixId], references: [id], onDelete: Cascade)
  driver             Driver?                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  team               Team?                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  source             Source                  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalReferences ExternalDataReference[]

  @@unique([seasonId, afterGrandPrixId, driverId])
  @@unique([seasonId, afterGrandPrixId, teamId])
  @@index([seasonId, afterGrandPrixId, kind, position])
  @@index([sourceId])
}

model ExternalDataReference {
  id                     String                @id @default(uuid()) @db.Uuid
  provider               SourceProvider
  resourceType           ExternalResourceType
  externalId             String
  sourceId               String                @db.Uuid
  sourceUrl              String?
  fetchedAt              DateTime              @default(now()) @db.Timestamptz(3)
  sourceTimestamp        DateTime?             @db.Timestamptz(3)
  seasonId               String?               @db.Uuid
  circuitId              String?               @db.Uuid
  grandPrixId            String?               @db.Uuid
  sessionId              String?               @db.Uuid
  raceId                 String?               @db.Uuid
  driverId               String?               @db.Uuid
  teamId                 String?               @db.Uuid
  raceMomentId           String?               @db.Uuid
  lapId                  String?               @db.Uuid
  positionId             String?               @db.Uuid
  pitStopId              String?               @db.Uuid
  tyreStintId            String?               @db.Uuid
  raceControlEventId     String?               @db.Uuid
  resultId               String?               @db.Uuid
  championshipStandingId String?               @db.Uuid
  source                 Source                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  season                 Season?               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  circuit                Circuit?              @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  grandPrix              GrandPrix?            @relation(fields: [grandPrixId], references: [id], onDelete: Cascade)
  session                Session?              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  race                   Race?                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  driver                 Driver?               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  team                   Team?                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  raceMoment             RaceMoment?           @relation(fields: [raceMomentId], references: [id], onDelete: Cascade)
  lap                    Lap?                  @relation(fields: [lapId], references: [id], onDelete: Cascade)
  position               Position?             @relation(fields: [positionId], references: [id], onDelete: Cascade)
  pitStop                PitStop?              @relation(fields: [pitStopId], references: [id], onDelete: Cascade)
  tyreStint              TyreStint?            @relation(fields: [tyreStintId], references: [id], onDelete: Cascade)
  raceControlEvent       RaceControlEvent?     @relation(fields: [raceControlEventId], references: [id], onDelete: Cascade)
  result                 Result?               @relation(fields: [resultId], references: [id], onDelete: Cascade)
  championshipStanding   ChampionshipStanding? @relation(fields: [championshipStandingId], references: [id], onDelete: Cascade)

  @@unique([provider, resourceType, externalId])
  @@index([sourceId])
  @@index([seasonId])
  @@index([circuitId])
  @@index([grandPrixId])
  @@index([sessionId])
  @@index([raceId])
  @@index([driverId])
  @@index([teamId])
  @@index([raceMomentId])
  @@index([lapId])
  @@index([positionId])
  @@index([pitStopId])
  @@index([tyreStintId])
  @@index([raceControlEventId])
  @@index([resultId])
  @@index([championshipStandingId])
}
